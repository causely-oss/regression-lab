# Required for both conditions
export ANTHROPIC_API_KEY=sk-ant-...

# Prometheus (condition A + B)
# Default: http://localhost:9090 — port-forward with:
#   kubectl port-forward -n scenario-01 svc/prometheus 9090:9090 &
export PROMETHEUS_URL=http://localhost:9090

# Causely (condition B only)
export CAUSELY_API_URL=https://app.causely.io
export CAUSELY_API_KEY=...
